# ============================================================
#  Plantilla de variables de entorno — copiar a .env y rellenar
#  El archivo .env está en .gitignore: NUNCA se sube a GitHub
#     cp .env.example .env && docker compose up -d --build
# ============================================================

# --- Proveedor LLM (Anthropic) ---
# Opcional: sin clave, las llamadas fallan con 401, el circuito se abre y los
# tickets reciben el triaje por reglas (RN-06).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Modelo usado por servicio-agente-triaje (por defecto claude-opus-5-5)
LLM_MODELO=claude-opus-5-5

# --- Base de datos PostgreSQL ---
POSTGRES_DB=triageai
POSTGRES_USER=triageai
POSTGRES_PASSWORD=cambiar-esta-contraseña

# --- Redis ---
REDIS_PASSWORD=cambiar-esta-contraseña

# --- Imágenes (opcional) ---
# Etiqueta de las imágenes locales; usa el hash de un commit para probar
# una imagen publicada en GitHub Container Registry.
TAG=dev
