# ============================================================
#  Plantilla de variables de entorno — copiar a .env y rellenar
#  El archivo .env está en .gitignore: NUNCA se sube a GitHub
# ============================================================

# --- Proveedor LLM secundario (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Base de datos PostgreSQL ---
POSTGRES_DB=triageai
POSTGRES_USER=triageai
POSTGRES_PASSWORD=cambiar-esta-contraseña

# --- Redis ---
REDIS_PASSWORD=cambiar-esta-contraseña
